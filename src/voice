#!/bin/bash
# Controle da voz do Claude Code. Uso: voice <comando>
V="$HOME/.claude/voice"; R="$V/run"; PIDF="$R/play.pid"; OFF="$HOME/.claude/hooks/voice.off"
mkdir -p "$R"
bar(){ b=$(cat "$R/bar.pid" 2>/dev/null); [ -n "$b" ] && kill -0 "$b" 2>/dev/null && echo "$b"; }
send(){ echo "$*" > "$R/cmd"; }
# Uma linha por sessão do Claude Code aberta agora, com quatro campos separados
# por SEP: pid, id da sessão, nome que o Claude Code deu a ela e o nome que ela
# fala. O nome falado segue a regra do menu Projetos que falam.
SEP=$'\x1f'
sessoes(){
  local f pid ini ms sid cnome cwd nome
  for f in "$HOME/.claude/sessions"/*.json; do
    [ -f "$f" ] || continue
    pid=$(basename "$f" .json); kill -0 "$pid" 2>/dev/null || continue
    ini=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$pid" | sed 's/ *$//')
    ini=$(LC_ALL=C date -j -u -f "%a %b %e %T %Y" "$ini" +%s 2>/dev/null) || continue
    ms=0; sid=""; cnome=""; cwd=""
    IFS="$SEP" read -r ms sid cnome cwd < <(jq -r --arg s "$SEP" \
      '[(.startedAt // 0 | tostring), .sessionId // "", .name // "", .cwd // ""] | join($s)' "$f" 2>/dev/null)
    # registro que sobrou de uma sessão que caiu, com o PID reaproveitado
    [ "${ms:-0}" != 0 ] && [ "$ini" -gt $(( ms / 1000 + 5 )) ] && continue
    nome=""
    [ -f "$R/sessoes/$pid" ] && [ "$(stat -f %m "$R/sessoes/$pid")" -ge "$ini" ] && nome=$(cat "$R/sessoes/$pid")
    if [ -z "$nome" ] && [ -n "$cwd" ]; then
      case "$cwd" in */.claude/worktrees/*) nome=${cwd#*/.claude/worktrees/}; nome=${nome%%/*};;
                     *) nome=$(basename "$cwd");; esac
    fi
    [ -n "$nome" ] && printf '%s\n' "$pid$SEP$sid$SEP$cnome$SEP$nome"
  done
}
# Nome de cada sessão aberta agora, um por linha (repete se houver várias no mesmo projeto).
abertos(){ sessoes | cut -d"$SEP" -f4; }

# Põe um texto na fila como fala de uma sessão: o mesmo anúncio, a mesma legenda,
# o mesmo silenciamento e a mesma fila das respostas do Claude Code. É a porta
# de entrada para outros aplicativos. Saída: 0 na fila, 1 uso errado, 2 app
# fechado, 3 síntese falhou, 4 sessão silenciada, 5 sessão não está aberta.
falar(){
  local alvo="" origem="" agora=0 anuncia=1 resume=1 simula=0 texto=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --sessao|--sessão|-s|--origem|-o)
        [ $# -ge 2 ] || { echo "falta o valor de $1" >&2; return 1; }
        case "$1" in --origem|-o) origem="$2";; *) alvo="$2";; esac; shift 2;;
      --agora)       agora=1; shift;;
      --sem-anuncio|--sem-anúncio) anuncia=0; shift;;
      --sem-resumo)  resume=0; shift;;
      --simular)     simula=1; shift;;
      --) shift; break;;
      -*) echo "opção desconhecida: $1" >&2; return 1;;
      *)  break;;
    esac
  done
  if [ $# -gt 0 ]; then texto="$*"; elif [ ! -t 0 ]; then texto=$(tr -d '\000'); fi
  texto=$(printf '%s' "$texto" | LC_ALL=C tr '\n\r\t' '   ' | LC_ALL=C sed 's/  */ /g; s/^ //; s/ $//')
  texto=${texto:0:20000}
  [ -z "$texto" ] && { echo "uso: voice falar [--sessao <id|pid|nome>] [--agora] \"texto\"" >&2; return 1; }

  # a sessão pode vir pelo id, pelo pid ou pelo nome que o Claude Code deu a ela;
  # fora isso, o valor vale como nome de projeto, o mesmo de voice mute e legenda
  local proj="mensagem" sess="" cnome="" p s c n
  if [ -n "$alvo" ]; then
    proj=""
    while IFS="$SEP" read -r p s c n; do
      [ -n "$p" ] || continue
      if [ "$alvo" = "$p" ] || [ "$alvo" = "$s" ] || [ "$alvo" = "$c" ]; then
        proj="$n"; sess="$s"; cnome="$c"; break
      fi
    done <<< "$(sessoes)"
    if [ -z "$proj" ]; then
      if printf '%s' "$alvo" | grep -Eqi '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then
        echo "a sessão $alvo não está aberta" >&2; return 5
      fi
      proj="$alvo"
    fi
  fi
  # uma quebra de linha no nome viraria um campo a mais no pedido da fila
  proj=$(printf '%s' "$proj" | LC_ALL=C tr -d '\000-\037')
  origem=$(printf '%s' "$origem" | LC_ALL=C tr -d '\000-\037')

  # app fechado, ninguém fala: é o que Sair significa
  if [ "$simula" = 0 ] && [ -z "$(bar)" ]; then
    echo "o VoiceBar está fechado; abra com voice bar" >&2; return 2
  fi
  # silenciado antes de gastar CPU sintetizando, como nos ganchos
  if grep -qxF "$proj" "$V/muted.txt" 2>/dev/null; then
    echo "$proj está silenciado; nada foi falado" >&2; return 4
  fi

  local nome="$origem"
  if [ -z "$nome" ]; then
    nome=$(awk -F'|' -v p="$proj" '$1 == p { sub(/^[^|]*\|/, ""); print; exit }' "$V/labels.txt" 2>/dev/null)
    [ -z "$nome" ] && nome=$(printf '%s' "$proj" | tr '_.-' '   ' | sed 's/  */ /g; s/^ //; s/ $//')
  fi

  if [ "$resume" = 1 ]; then
    local sum; sum=$(printf '%s' "$texto" | "$V/summarize.sh" 2>/dev/null)
    [ -n "$sum" ] && texto="$sum"
  fi

  local log="$HOME/.claude/hooks/speak-response.log" voz stamp wav ann=""
  voz=$(cat "$V/current" 2>/dev/null || echo cadu)
  stamp=$(date +%s); wav="$R/r-ext-$$-$stamp.wav"
  mkdir -p "$R/q"
  if ! printf '%s' "$texto" | "$V/synth.sh" "$voz" "$wav" 2>>"$log"; then
    echo "$(date '+%F %T') falar: sintese falhou ($voz)" >> "$log"
    rm -f "$wav"; echo "não consegui gerar o áudio" >&2; return 3
  fi
  if [ "$anuncia" = 1 ] && [ "$(cat "$V/announce" 2>/dev/null || echo 1)" = 1 ]; then
    ann="$R/a-ext-$$-$stamp.wav"
    printf '%s.' "$nome" | "$V/synth.sh" "$voz" "$ann" 2>>"$log" || ann=""
    { [ -n "$ann" ] && [ -s "$ann" ]; } || ann=""
  fi

  # prio=1 fura a fila como o texto selecionado; prio=0 espera a vez
  local pedido; pedido=$(printf 'wav=%s\nann=%s\nproj=%s\nsess=%s\nts=%s\nprio=%s' \
                           "$wav" "$ann" "$proj" "$sess" "$stamp" "$agora")
  if [ "$simula" = 1 ]; then
    echo "simulação, nada entrou na fila"
    if [ -n "$ann" ]; then echo "  anúncio: \"$nome\""; else echo "  anúncio: nenhum"; fi
    printf '%s\n' "$pedido" | sed 's/^/  /'
    rm -f "$wav" "$ann"; return 0
  fi
  # grava ao lado e renomeia: o app nunca lê um pedido pela metade
  local job="$R/q/$stamp-ext-$$.job"
  printf '%s\n' "$pedido" > "$job.tmp" && mv "$job.tmp" "$job"
  echo "na fila: $nome${cnome:+ (sessão $cnome)}"
  [ "$(cat "$R/silencio" 2>/dev/null)" = 1 ] && echo "silêncio ligado: a fala espera até ele ser desligado"
  return 0
}
pid(){ [ -f "$PIDF" ] && p=$(cat "$PIDF" 2>/dev/null) && kill -0 "$p" 2>/dev/null && echo "$p"; }
st(){ p=$(pid); [ -z "$p" ] && { echo parado; return; }
      s=$(ps -o stat= -p "$p" 2>/dev/null); case "$s" in *T*) echo pausado;; *) echo tocando;; esac; }

case "${1:-status}" in
  pause)  [ -n "$(bar)" ] && { send pause; echo pausado; exit 0; }
          p=$(pid); [ -n "$p" ] && kill -STOP "$p" && echo "pausado" || echo "nada tocando";;
  resume|cont) [ -n "$(bar)" ] && { send resume; echo retomado; exit 0; }
          p=$(pid); [ -n "$p" ] && kill -CONT "$p" && echo "retomado" || echo "nada pausado";;
  toggle) [ -n "$(bar)" ] && { send toggle; echo alternado; exit 0; }
          p=$(pid); [ -z "$p" ] && { echo "nada tocando"; exit 0; }
          if [ "$(st)" = pausado ]; then kill -CONT "$p"; echo retomado; else kill -STOP "$p"; echo pausado; fi;;
  repetir|repeat) [ -n "$(bar)" ] && { send repetir; echo "repetindo a última"; exit 0; }
          W="$R/ultima.wav"
          [ -s "$W" ] && { afplay -v "$(cat $V/volume 2>/dev/null || echo 1)" "$W"; } || echo "nada para repetir";;
  skip|pular) [ -n "$(bar)" ] && { send skip; echo "pulou"; exit 0; }; echo "app da barra nao esta rodando";;
  clear|limpar) [ -n "$(bar)" ] && { send clear; echo "fila limpa"; exit 0; }
          find "$R/q" -name '*.job' -delete 2>/dev/null; echo "fila limpa";;
  pick|ouvir) n="$2"; [ -z "$n" ] && { echo "uso: voice pick <numero da fila>"; exit 1; }
          [ -n "$(bar)" ] && { send pick "$n"; echo "tocando o item $n (o atual volta para a fila)"; exit 0; }
          echo "app da barra nao esta rodando";;
  queue|fila) n=$(find "$R/q" -name '*.job' 2>/dev/null | wc -l | tr -d ' ')
          echo "na fila: $n"
          # na ordem em que vão tocar, com o número que o voice pick usa
          i=0; for f in $(ls "$R/q"/*.job 2>/dev/null); do
            i=$((i+1)); echo "  $i. $(grep '^proj=' $f | cut -d= -f2)"; done;;
  mute|silenciar) [ -z "$2" ] && { echo "silenciados:"; sed 's/^/  /' "$V/muted.txt" 2>/dev/null; exit 0; }
          grep -qxF "$2" "$V/muted.txt" 2>/dev/null || echo "$2" >> "$V/muted.txt"; echo "$2 silenciado";;
  unmute|ativar) [ -z "$2" ] && { : > "$V/muted.txt"; echo "todos ativados"; exit 0; }
          grep -vxF "$2" "$V/muted.txt" > "$V/.m" 2>/dev/null; mv "$V/.m" "$V/muted.txt"; echo "$2 ativado";;
  mode|modo) [ -z "$2" ] && { echo "modo atual: $(cat $V/mode 2>/dev/null)"; exit 0; }
          case "$2" in fila|ultima) echo "$2" > "$V/mode"; echo "modo: $2";; *) echo "use: fila | ultima";; esac;;
  projects|projetos)
          if [ "$2" != todos ] && [ -d "$HOME/.claude/sessions" ]; then
            echo "projetos com sessão aberta agora (e o que cada um fala):"
            LISTA=$(abertos | sort -f | uniq -c | sed 's/^ *//')
            [ -z "$LISTA" ] && echo "  nenhuma sessão do Claude Code aberta"
          else
            echo "projetos que já falaram (e o que cada um fala):"
            LISTA=$(sed 's/^/1 /' "$V/projects.txt" 2>/dev/null)
          fi
          printf '%s\n' "$LISTA" | while read -r n p; do
            [ -z "$p" ] && continue
            L=$(grep "^$p|" "$V/labels.txt" 2>/dev/null | head -1 | cut -d'|' -f2-)
            [ -z "$L" ] && L=$(printf '%s' "$p" | tr '_.-' '   ' | sed 's/  */ /g; s/^ //; s/ $//')
            M=$(grep -qxF "$p" "$V/muted.txt" 2>/dev/null && echo " [mudo]")
            S=""; [ "${n:-1}" -gt 1 ] && S=" ($n sessões)"
            printf "  %-24s \"%s\"%s%s\n" "$p" "$L" "$S" "$M"
          done;;
  legenda|label) p="$2"
          [ -z "$p" ] && { echo "o que cada projeto fala:"; sed 's/|/  ->  /;s/^/  /' "$V/labels.txt" 2>/dev/null
                           [ -s "$V/labels.txt" ] || echo "  (nenhuma legenda; todos usam o nome da pasta)"; exit 0; }
          shift 2; t="$*"
          grep -v "^$p|" "$V/labels.txt" 2>/dev/null > "$V/.l"; mv "$V/.l" "$V/labels.txt"
          if [ -z "$t" ] || [ "$t" = "limpar" ]; then echo "$p volta a falar o nome da pasta"
          else printf '%s|%s\n' "$p" "$t" >> "$V/labels.txt"; echo "$p passa a falar: \"$t\""; fi;;
  stop)   [ -n "$(bar)" ] && { send stop; echo parado; exit 0; }
          p=$(pid); [ -n "$p" ] && { kill -CONT "$p" 2>/dev/null; kill "$p" 2>/dev/null; }
          rm -f "$PIDF"; echo "parado";;
  vol)    v="$2"; [ -z "$v" ] && { echo "volume atual: $(cat $V/volume 2>/dev/null)"; exit 0; }
          echo "$v" > "$V/volume"; [ -n "$(bar)" ] && send vol "$v"; echo "volume: $v";;
  speed|vel) v="$2"; [ -z "$v" ] && { echo "velocidade atual: $(cat $V/speed 2>/dev/null || echo 1.0)"; exit 0; }
          echo "$v" > "$V/speed"; [ -n "$(bar)" ] && send speed "$v"; echo "velocidade: ${v}x";;
  announce|anuncio) case "$2" in
            on|1)  echo 1 > "$V/announce"; echo "anúncio ligado";;
            off|0) echo 0 > "$V/announce"; echo "anúncio desligado";;
            *) echo "anúncio: $([ "$(cat $V/announce 2>/dev/null||echo 1)" = 1 ] && echo ligado || echo desligado)";;
          esac;;
  avisos|alerts) case "$2" in
            on|1)  echo 1 > "$V/alerts"; echo "avisos ligados";;
            off|0) echo 0 > "$V/alerts"; echo "avisos desligados";;
            *) echo "avisos: $([ "$(cat $V/alerts 2>/dev/null||echo 1)" = 1 ] && echo ligados || echo desligados)"
               echo "  pergunta | permissao | atencao | erro";;
          esac;;
  pausa) case "$2" in
            sem|curta|media|média|longa) echo "${2/média/media}" > "$V/pause"; echo "pausa: ${2}";;
            *) echo "pausa atual: $(cat $V/pause 2>/dev/null || echo media)"
               echo "opções: sem | curta | media | longa";;
          esac;;
  resumo|summary)
          C="$V/summary.conf"
          put(){ grep -v "^$1=" "$C" 2>/dev/null > "$V/.c"; echo "$1=$2" >> "$V/.c"; sort "$V/.c" > "$C"; rm -f "$V/.c"; }
          get2(){ grep "^$1=" "$C" 2>/dev/null | head -1 | cut -d= -f2-; }
          case "$2" in
            on|1)   put enabled 1; echo "resumo ligado";;
            off|0)  put enabled 0; echo "resumo desligado";;
            pct|%)  [ -z "$3" ] && { echo "redução atual: $(get2 percent)%"; exit 0; }
                    put mode percent; put percent "${3%\%}"; echo "reduzir em ${3%\%}%";;
            palavras|words) [ -z "$3" ] && { echo "alvo atual: $(get2 words) palavras"; exit 0; }
                    put mode words; put words "$3"; echo "resumir em $3 palavras";;
            min)    [ -z "$3" ] && { echo "mínimo atual: $(get2 min_words) palavras"; exit 0; }
                    put min_words "$3"; echo "só resume acima de $3 palavras";;
            modelo|model) [ -z "$3" ] && { echo "modelo atual: $(get2 model)"; exit 0; }
                    put model "$3"; echo "modelo: $3";;
            modelos|models) sed 's/^/  /' "$V/models.txt" 2>/dev/null || echo "  (use Buscar na janela Resumo por IA)";;
            prompt|instrucoes|instruções)
                    P="$V/summary_prompt.txt"
                    case "$3" in
                      "")      if [ -s "$P" ]; then echo "instruções para a IA:"; sed 's/^/  /' "$P"
                               else echo "nenhuma instrução definida"; fi;;
                      limpar|clear) : > "$P"; echo "instruções apagadas";;
                      -)       cat > "$P"; echo "instruções lidas da entrada padrão";;
                      *)       shift 2; printf '%s\n' "$*" > "$P"; echo "instruções salvas";;
                    esac;;
            *) echo "resumo : $([ "$(get2 enabled)" = 1 ] && echo ligado || echo desligado)"
               echo "modo   : $([ "$(get2 mode)" = words ] && echo "$(get2 words) palavras" || echo "reduzir $(get2 percent)%")"
               echo "mínimo : $(get2 min_words) palavras"
               echo "modelo : $(get2 model)"
               echo "chave  : $([ -s "$V/openai.env" ] && echo guardada || echo ausente)";;
          esac;;
  off)    touch "$OFF"; p=$(pid); [ -n "$p" ] && { kill -CONT "$p" 2>/dev/null; kill "$p" 2>/dev/null; }
          echo "voz DESLIGADA";;
  on)     rm -f "$OFF"; echo "voz LIGADA";;
  use)    v="$2"; grep -q "^$v|" "$V/voices.txt" || { echo "voz '$v' não existe. veja: voice list"; exit 1; }
          echo "$v" > "$V/current"; echo "voz agora: $v";;
  list)   echo "vozes disponíveis:"; awk -F'|' '{printf "  %-10s %s\n",$1,$4}' "$V/voices.txt"
          echo "atual: $(cat $V/current 2>/dev/null)";;
  falar|speak) shift; falar "$@"; exit $?;;
  sessoes|sessões|sessions)
          L=$(sessoes); [ -z "$L" ] && { echo "nenhuma sessão do Claude Code aberta"; exit 0; }
          echo "sessões abertas agora (qualquer coluna menos PROJETO serve no voice falar --sessao):"
          printf "  %-7s %-36s %-28s %s\n" PID ID NOME PROJETO
          printf '%s\n' "$L" | sort -t"$SEP" -k4,4f -k3,3f | while IFS="$SEP" read -r p s c n; do
            printf "  %-7s %-36s %-28s %s\n" "$p" "$s" "$c" "$n"; done;;
  say)    shift; t="$*"; [ -z "$t" ] && { echo "uso: voice say \"texto\""; exit 1; }
          "$V/synth.sh" "$(cat $V/current)" "$R/say.wav" <<< "$t" || exit 1
          afplay -v "$(cat $V/volume 2>/dev/null || echo 1)" "$R/say.wav";;
  bar)    b=$(bar); [ -n "$b" ] && echo "app da barra rodando (pid $b)" || {
            # reinicia pelo launchd quando ele conhece o servico, senao direto
            if launchctl list 2>/dev/null | grep -q com.claude.voicebar; then
              launchctl kickstart -k "gui/$(id -u)/com.claude.voicebar" 2>/dev/null
            else
              nohup "$V/voicebar" >/dev/null 2>&1 & disown
            fi
            sleep 2; b=$(bar)
            [ -n "$b" ] && echo "app da barra iniciado (pid $b)" || echo "nao consegui iniciar"; };;
  restart|reiniciar)
          launchctl kickstart -k "gui/$(id -u)/com.claude.voicebar" 2>/dev/null \
            || { pkill -x voicebar 2>/dev/null; nohup "$V/voicebar" >/dev/null 2>&1 & disown; }
          sleep 2; b=$(bar)
          [ -n "$b" ] && echo "reiniciado (pid $b)" || echo "nao consegui reiniciar";;
  silencio|mudo) [ -n "$(bar)" ] && { send silencio; echo "silêncio alternado"; exit 0; }
          echo "app da barra nao esta rodando";;
  quit|sair) [ -n "$(bar)" ] && { send quit; sleep 1; echo "app encerrado; nada mais sera falado ate voice bar"; } \
             || echo "ja estava fechado; nada esta sendo falado";;
  status) [ -n "$(bar)" ] && echo "estado : controlado pelo app da barra" \
            || echo "estado : APP FECHADO, nada e falado; abra com voice bar"
          echo "voz    : $(cat $V/current 2>/dev/null)"
          echo "volume : $(cat $V/volume 2>/dev/null)"
          echo "veloc. : $(cat $V/speed 2>/dev/null || echo 1.0)x"
          echo "modo   : $(cat $V/mode 2>/dev/null)"
          [ "$(cat $R/silencio 2>/dev/null)" = "1" ] && echo "SILÊNCIO: ligado, a fila está retida"
          echo "anúncio: $([ "$(cat $V/announce 2>/dev/null||echo 1)" = 1 ] && echo ligado || echo desligado)"
          echo "avisos : $([ "$(cat $V/alerts 2>/dev/null||echo 1)" = 1 ] && echo ligados || echo desligados)"
          echo "fila   : $(find "$R/q" -name '*.job' 2>/dev/null | wc -l | tr -d ' ')"
          m=$(tr '\n' ' ' < "$V/muted.txt" 2>/dev/null); [ -n "$m" ] && echo "mudos  : $m"
          [ -f "$OFF" ] && echo "hook   : DESLIGADO (voice on para religar)" || echo "hook   : ligado";;
  *) echo "Controle da voz do Claude Code.  Uso: voice <comando> [valor]"
     echo "Sem valor, cada comando mostra o ajuste atual."
     echo
     echo "REPRODUÇÃO"
     echo "  pause | resume | toggle      pausa, retoma, alterna"
     echo "  silencio                     modo ligação: pausa e segura a fila"
     echo "  skip                         pula a fala atual e chama a próxima"
     echo "  repetir                      toca de novo a última fala"
     echo "  stop                         descarta a fala atual"
     echo "  clear                        esvazia a fila sem cortar a atual"
     echo
     echo "SOM"
     echo "  vol <0-1>                    volume, vale no meio da frase"
     echo "  speed <0.6-1.8>              velocidade, sem alterar o tom"
     echo "  use <voz> | list             troca e lista as sete vozes"
     echo
     echo "FILA E PROJETOS"
     echo "  fila                         quem está tocando e quem espera"
     echo "  pick <n>                     ouve o item n; o atual volta para a fila"
     echo "  mode <fila|ultima>           enfileirar tudo ou só a mais recente"
     echo "  mute <proj> | unmute [proj]  silencia ou reativa um projeto"
     echo "  projetos                     lista os projetos com sessão aberta agora"
     echo "  projetos todos               lista todos os que já falaram"
     echo
     echo "ANÚNCIO E PAUSAS"
     echo "  announce <on|off>            falar a origem antes da leitura"
     echo "  avisos <on|off>              avisar quando o Claude precisar de voce"
     echo "  pausa <sem|curta|media|longa>  silêncio ao trocar de projeto"
     echo
     echo "RESUMO POR IA"
     echo "  resumo                       estado completo"
     echo "  resumo <on|off>              liga e desliga"
     echo "  resumo pct <n>               reduzir em n por cento"
     echo "  resumo palavras <n>          alvo fixo de n palavras"
     echo "  resumo min <n>               não resumir abaixo de n palavras"
     echo "  resumo modelo <nome>         escolhe o modelo"
     echo "  resumo modelos               lista os modelos buscados"
     echo
     echo "OUTROS APLICATIVOS"
     echo "  falar [opções] <texto>       põe um texto na fila como fala de uma sessão"
     echo "    --sessao <alvo>            id, pid ou nome da sessão no Claude Code,"
     echo "                               ou o nome de um projeto (padrão: mensagem)"
     echo "    --origem <nome>            o que o anúncio diz (padrão: legenda do projeto)"
     echo "    --agora                    fura a fila, como o texto selecionado"
     echo "    --sem-anuncio              não fala a origem antes"
     echo "    --sem-resumo               nunca resume, mesmo com o resumo ligado"
     echo "    --simular                  gera o áudio e mostra o pedido, sem falar"
     echo "    o texto também pode vir pela entrada padrão. Saída: 0 na fila,"
     echo "    2 app fechado, 3 síntese falhou, 4 silenciado, 5 sessão fechada"
